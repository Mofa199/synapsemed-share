# SynapseMed Environment Variables

# Database Connection (Neon PostgreSQL or local)
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/db?schema=public"

# Authentication (NextAuth / JWT)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here"
JWT_SECRET="your-jwt-secret-key-here"

# Google Gemini AI Assistant
GEMINI_API_KEY="your-google-gemini-api-key"

# Email Configuration (Nodemailer for OTPs)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# WhatsApp Custom Server API
WHATSAPP_SERVER_URL="http://localhost:8000"
WHATSAPP_API_KEY="your-custom-whatsapp-api-key"

# Site URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
