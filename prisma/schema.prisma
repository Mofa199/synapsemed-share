generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  password                String
  role                    UserRole                 @default(STUDENT)
  field                   UserField
  avatarUrl               String?
  level                   Int                      @default(1)
  points                  Int                      @default(0)
  streak                  Int                      @default(0)
  isActive                Boolean                  @default(true)
  isVerified              Boolean                  @default(false)
  otpCode                 String?
  otpExpiry               DateTime?
  lastLoginAt             DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  createdContent          Article[]                @relation("ArticleAuthor")
  bookmarks               Bookmark[]
  chatMessages            ChatMessage[]
  highlights              Highlight[]
  notes                   Note[]                   @relation("UserNotes")
  progress                Progress[]
  questionOfTheDayAnswers QuestionOfTheDayAnswer[]
  ratings                 Rating[]
  userBadges              UserBadge[]
  userChallenges          UserChallenge[]
  subscription            Subscription?
  paymentTransactions     PaymentTransaction[]

  @@map("users")
}

model Curriculum {
  id          String    @id @default(cuid())
  name        String
  description String?
  field       UserField
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
  books       Book[]
  drugs       Drug[]
  flashcards  FlashcardSet[]
  magazines   Magazine[]
  modules     Module[]
  questionBanks QuestionBank[]
  simulations Simulation[]
  studyGuides StudyGuide[]
  topics      Topic[]
  videos      Video[]

  @@map("curricula")
}

model Module {
  id           String     @id @default(cuid())
  name         String
  description  String?
  curriculumId String
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  articles     Article[]
  books        Book[]
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  drugs        Drug[]
  flashcards   FlashcardSet[]
  magazines    Magazine[]
  questionBanks QuestionBank[]
  simulations  Simulation[]
  studyGuides  StudyGuide[]
  topics       Topic[]
  videos       Video[]

  @@map("modules")
}

model Topic {
  id           String      @id @default(cuid())
  title        String
  description  String
  content      String
  type         ContentType @default(ARTICLE)
  difficulty   Difficulty  @default(BEGINNER)
  duration     String?
  category     String?
  tags         String
  isPublished  Boolean     @default(false)
  views        Int         @default(0)
  curriculumId String?
  moduleId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  bookmarks    Bookmark[]
  highlights   Highlight[]
  progress     Progress[]
  ratings      Rating[]
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id])
  module       Module?     @relation(fields: [moduleId], references: [id])
  videos       Video[]

  @@map("topics")
}

model Article {
  id          String      @id @default(cuid())
  title       String
  author      String
  authorId    String?
  authorBio   String?
  journal     String?
  category    String?
  abstract    String?
  content     String
  keywords    String
  references  String
  readTime    String?
  difficulty  Difficulty  @default(BEGINNER)
  views       Int         @default(0)
  isPublished Boolean     @default(false)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  curriculumId String?
  moduleId    String?
  authorUser  User?       @relation("ArticleAuthor", fields: [authorId], references: [id])
  curriculum  Curriculum? @relation(fields: [curriculumId], references: [id])
  module      Module?     @relation(fields: [moduleId], references: [id])
  bookmarks   Bookmark[]
  highlights  Highlight[]
  progress    Progress[]
  ratings     Rating[]

  @@map("articles")
}

model Book {
  id              String      @id @default(cuid())
  title           String
  author          String
  isbn            String?
  publisher       String?
  publicationYear Int?
  edition         String?
  pages           Int?
  language        String      @default("English")
  format          BookFormat  @default(PDF)
  description     String?
  coverUrl        String?
  fileUrl         String?
  category        String?
  tags            String
  isPublished     Boolean     @default(false)
  views           Int         @default(0)
  curriculumId    String?
  moduleId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  bookmarks       Bookmark[]
  progress        Progress[]
  curriculum      Curriculum? @relation(fields: [curriculumId], references: [id])
  module          Module?     @relation(fields: [moduleId], references: [id])
  ratings         Rating[]

  @@map("books")
}

model DrugClass {
  id                String   @id @default(cuid())
  name              String
  description       String?
  category          String
  mechanism         String?
  therapeuticUses   String?
  commonSideEffects String?
  contraindications String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  drugs             Drug[]

  @@map("drug_classes")
}

model Drug {
  id                         String     @id @default(cuid())
  name                       String
  genericName                String?
  brandNames                 String
  drugClassId                String
  description                String?
  mechanism                  String?
  indications                String
  dosageAdult                String?
  dosagePediatric            String?
  dosageElderly              String?
  administrationRoute        String?
  administrationTiming       String?
  administrationInstructions String?
  contraindications          String
  warnings                   String
  sideEffectsCommon          String
  sideEffectsSerious         String
  sideEffectsRare            String
  interactions               String
  monitoring                 String
  storage                    String?
  pregnancy                  String?
  absorption                 String?
  distribution               String?
  metabolism                 String?
  elimination                String?
  halfLife                   String?
  isActive                   Boolean    @default(true)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  curriculumId               String?
  moduleId                   String?
  bookmarks                  Bookmark[]
  progress                   Progress[]
  drugClass                  DrugClass  @relation(fields: [drugClassId], references: [id], onDelete: Cascade)
  curriculum                 Curriculum? @relation(fields: [curriculumId], references: [id])
  module                     Module?     @relation(fields: [moduleId], references: [id])
  ratings                    Rating[]

  @@map("drugs")
}

model QuestionBank {
  id             String     @id @default(cuid())
  title          String
  description    String?
  category       String
  difficulty     Difficulty @default(BEGINNER)
  totalQuestions Int        @default(0)
  estimatedTime  String?
  tags           String
  isPublished    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  curriculumId   String?
  moduleId       String?
  bookmarks      Bookmark[]
  progress       Progress[]
  questions      Question[]
  ratings        Rating[]
  curriculum     Curriculum? @relation(fields: [curriculumId], references: [id])
  module         Module?     @relation(fields: [moduleId], references: [id])

  @@map("question_banks")
}

model Question {
  id             String       @id @default(cuid())
  questionBankId String
  question       String
  options        String
  correctAnswer  Int
  explanation    String?
  difficulty     Difficulty   @default(BEGINNER)
  tags           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model StudyGuide {
  id            String      @id @default(cuid())
  title         String
  description   String?
  content       String
  category      String
  difficulty    Difficulty  @default(BEGINNER)
  estimatedTime String?
  tags          String
  isPublished   Boolean     @default(false)
  views         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  curriculumId  String?
  moduleId      String?
  bookmarks     Bookmark[]
  highlights    Highlight[]
  progress      Progress[]
  ratings       Rating[]
  curriculum    Curriculum? @relation(fields: [curriculumId], references: [id])
  module        Module?     @relation(fields: [moduleId], references: [id])

  @@map("study_guides")
}

model Badge {
  id             String      @id @default(cuid())
  name           String
  description    String?
  icon           String?
  color          String?
  category       String?
  criteria       String?
  pointsRequired Int?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userBadges     UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Bookmark {
  id             String        @id @default(cuid())
  userId         String
  resourceType   ResourceType
  topicId        String?
  articleId      String?
  bookId         String?
  drugId         String?
  questionBankId String?
  studyGuideId   String?
  magazineId     String?
  videoId        String?
  flashcardSetId String?
  simulationId   String?
  conceptId      String?
  createdAt      DateTime      @default(now())
  article        Article?      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  book           Book?         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  drug           Drug?         @relation(fields: [drugId], references: [id], onDelete: Cascade)
  flashcardSet   FlashcardSet? @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  magazine       Magazine?     @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  simulation     Simulation?   @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  studyGuide     StudyGuide?   @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  topic          Topic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video          Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, topicId, articleId, bookId, drugId, questionBankId, studyGuideId, magazineId, videoId, flashcardSetId, simulationId, conceptId])
  @@map("bookmarks")
}

model Highlight {
  id           String       @id @default(cuid())
  userId       String
  resourceType ResourceType
  topicId      String?
  articleId    String?
  studyGuideId String?
  text         String
  color        String       @default("yellow")
  note         String?
  createdAt    DateTime     @default(now())
  article      Article?     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  studyGuide   StudyGuide?  @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  topic        Topic?       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("highlights")
}

model Rating {
  id             String        @id @default(cuid())
  userId         String
  resourceType   ResourceType
  topicId        String?
  articleId      String?
  bookId         String?
  drugId         String?
  questionBankId String?
  studyGuideId   String?
  magazineId     String?
  videoId        String?
  flashcardSetId String?
  simulationId   String?
  rating         Int
  review         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  article        Article?      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  book           Book?         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  drug           Drug?         @relation(fields: [drugId], references: [id], onDelete: Cascade)
  flashcardSet   FlashcardSet? @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  magazine       Magazine?     @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  simulation     Simulation?   @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  studyGuide     StudyGuide?   @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  topic          Topic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video          Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, topicId, articleId, bookId, drugId, questionBankId, studyGuideId, magazineId, videoId, flashcardSetId, simulationId])
  @@map("ratings")
}

model Progress {
  id                   String         @id @default(cuid())
  userId               String
  resourceType         ResourceType
  topicId              String?
  articleId            String?
  bookId               String?
  videoId              String?
  drugId               String?
  questionBankId       String?
  studyGuideId         String?
  flashcardSetId       String?
  simulationId         String?
  magazineId           String?
  conceptId            String?
  status               ProgressStatus @default(NOT_STARTED)
  completionPercentage Int            @default(0)
  timeSpent            Int            @default(0)
  lastAccessedAt       DateTime       @default(now())
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  article              Article?       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  book                 Book?          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  video                Video?         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  drug                 Drug?          @relation(fields: [drugId], references: [id], onDelete: Cascade)
  flashcardSet         FlashcardSet?  @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  questionBank         QuestionBank?  @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  simulation           Simulation?    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  studyGuide           StudyGuide?    @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  topic                Topic?         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  magazine             Magazine?      @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  concept              Concept?       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, topicId, articleId, bookId, videoId, drugId, questionBankId, studyGuideId, flashcardSetId, simulationId, magazineId, conceptId])
  @@map("progress")
}


model ChatMessage {
  id        String      @id @default(cuid())
  userId    String
  channelId String?
  message   String
  response  String?
  role      MessageRole
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Partner {
  id              String        @id @default(cuid())
  name            String
  description     String
  type            PartnerType
  status          PartnerStatus @default(ACTIVE)
  website         String?
  contactName     String
  contactEmail    String
  contactPhone    String?
  logo            String?
  studentsCount   Int           @default(0)
  partnershipType String?
  joinDate        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("partners")
}

model TeamMember {
  id          String           @id @default(cuid())
  name        String
  email       String           @unique
  phone       String?
  position    String
  department  TeamDepartment
  status      TeamMemberStatus @default(ACTIVE)
  bio         String?
  avatar      String?
  linkedin    String?
  expertise   String?
  specialties String
  rating      Float?           @default(0)
  joinDate    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("team_members")
}

model WordOfTheDay {
  id            String     @id @default(cuid())
  word          String
  definition    String
  pronunciation String?
  etymology     String?
  category      String?
  difficulty    Difficulty @default(BEGINNER)
  example       String?
  dateScheduled DateTime   @unique
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("word_of_the_day")
}

model Magazine {
  id          String            @id @default(cuid())
  title       String
  issue       String?
  volume      String?
  description String?
  coverUrl    String?
  publishedAt DateTime?
  category    String?
  tags        String
  isPublished Boolean           @default(false)
  views       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  curriculumId String?
  moduleId    String?
  bookmarks   Bookmark[]
  progress    Progress[]
  articles    MagazineArticle[]
  ratings     Rating[]
  curriculum  Curriculum? @relation(fields: [curriculumId], references: [id])
  module      Module?     @relation(fields: [moduleId], references: [id])

  @@map("magazines")
}

model MagazineArticle {
  id         String   @id @default(cuid())
  magazineId String
  title      String
  author     String
  content    String
  pageNumber Int?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  magazine   Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)

  @@map("magazine_articles")
}

model Video {
  id           String      @id @default(cuid())
  title        String
  description  String?
  url          String
  thumbnail    String?
  duration     String?
  category     String?
  difficulty   Difficulty  @default(BEGINNER)
  tags         String
  curriculumId String?
  moduleId     String?
  topicId      String?
  isPublished  Boolean     @default(false)
  views        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  bookmarks    Bookmark[]
  progress     Progress[]
  ratings      Rating[]
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id])
  module       Module?     @relation(fields: [moduleId], references: [id])
  topic        Topic?      @relation(fields: [topicId], references: [id])

  @@map("videos")
}

model FlashcardSet {
  id          String      @id @default(cuid())
  title       String
  description String?
  category    String?
  difficulty  Difficulty  @default(BEGINNER)
  tags        String
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  curriculumId String?
  moduleId    String?
  bookmarks   Bookmark[]
  flashcards  Flashcard[]
  progress    Progress[]
  ratings     Rating[]
  curriculum  Curriculum? @relation(fields: [curriculumId], references: [id])
  module      Module?     @relation(fields: [moduleId], references: [id])

  @@map("flashcard_sets")
}

model Flashcard {
  id             String       @id @default(cuid())
  flashcardSetId String
  front          String
  back           String
  category       String?
  hint           String?
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  flashcardSet   FlashcardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model Simulation {
  id             String           @id @default(cuid())
  title          String
  description    String?
  patientAge     Int?
  patientGender  String?
  chiefComplaint String
  scenario       String
  difficulty     Difficulty       @default(BEGINNER)
  category       String?
  tags           String
  estimatedTime  String?
  isPublished    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  curriculumId   String?
  moduleId       String?
  bookmarks      Bookmark[]
  progress       Progress[]
  ratings        Rating[]
  steps          SimulationStep[]
  curriculum     Curriculum? @relation(fields: [curriculumId], references: [id])
  module         Module?     @relation(fields: [moduleId], references: [id])

  @@map("simulations")
}

model SimulationStep {
  id           String     @id @default(cuid())
  simulationId String
  title        String
  description  String
  stepType     StepType
  order        Int
  data         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@map("simulation_steps")
}

model Challenge {
  id             String          @id @default(cuid())
  title          String
  description    String
  type           ChallengeType
  difficulty     Difficulty      @default(BEGINNER)
  category       String?
  pointsReward   Int             @default(0)
  badgeReward    String?
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userChallenges UserChallenge[]

  @@map("challenges")
}

model UserChallenge {
  id          String          @id @default(cuid())
  userId      String
  challengeId String
  status      ChallengeStatus @default(NOT_STARTED)
  progress    Int             @default(0)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  challenge   Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("user_challenges")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  category  String   @default("General")
  tags      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model SpacedRepetitionCard {
  id             String     @id @default(cuid())
  userId         String
  front          String
  back           String
  category       String?
  tags           String
  difficulty     Difficulty @default(BEGINNER)
  easeFactor     Float      @default(2.5)
  interval       Int        @default(1)
  repetitions    Int        @default(0)
  nextReviewDate DateTime   @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId, nextReviewDate])
  @@map("spaced_repetition_cards")
}

model QuestionOfTheDay {
  id            String                   @id @default(cuid())
  question      String
  options       String
  correctAnswer Int
  explanation   String
  difficulty    Difficulty               @default(INTERMEDIATE)
  category      String?
  tags          String
  dateScheduled DateTime                 @unique
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userAnswers   QuestionOfTheDayAnswer[]

  @@map("question_of_the_day")
}

model QuestionOfTheDayAnswer {
  id         String           @id @default(cuid())
  userId     String
  questionId String
  answer     Int
  isCorrect  Boolean
  createdAt  DateTime         @default(now())
  question   QuestionOfTheDay @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("question_of_the_day_answers")
}

model StudyGoal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  progress    Int       @default(0)
  dueDate     DateTime?
  priority    Priority  @default(MEDIUM)
  category    String?
  tags        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("study_goals")
}

model StudySession {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String?
  sessionType SessionType
  date        DateTime
  startTime   String
  duration    Int
  status      SessionStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("study_sessions")
}

model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  goals       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("study_plans")
}

model VideoFavorite {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@map("video_favorites")
}

model VideoComment {
  id         String   @id @default(cuid())
  userId     String
  videoId    String
  userName   String
  userAvatar String?
  comment    String
  likes      Int      @default(0)
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("video_comments")
}

model VideoQuiz {
  id           String              @id @default(cuid())
  videoId      String
  title        String
  description  String?
  passingScore Int                 @default(70)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  attempts     VideoQuizAttempt[]
  questions    VideoQuizQuestion[]

  @@map("video_quizzes")
}

model VideoQuizQuestion {
  id            String    @id @default(cuid())
  videoQuizId   String
  question      String
  options       String
  correctAnswer Int
  explanation   String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  videoQuiz     VideoQuiz @relation(fields: [videoQuizId], references: [id], onDelete: Cascade)

  @@map("video_quiz_questions")
}

model VideoQuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  videoQuizId    String
  score          Int
  totalQuestions Int
  answers        String
  passed         Boolean
  createdAt      DateTime  @default(now())
  videoQuiz      VideoQuiz @relation(fields: [videoQuizId], references: [id], onDelete: Cascade)

  @@map("video_quiz_attempts")
}

model VideoProgress {
  id            String   @id @default(cuid())
  userId        String
  videoId       String
  watchTime     Int      @default(0)
  totalDuration Int
  completed     Boolean  @default(false)
  lastPosition  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, videoId])
  @@map("video_progress")
}

model Concept {
  id          String     @id @default(cuid())
  title       String
  description String
  content     String
  category    String
  difficulty  Difficulty @default(INTERMEDIATE)
  readTime    String?
  tags        String
  summary     String?
  keyPoints   String?
  isPublished Boolean    @default(false)
  views       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  mnemonics   Mnemonic[]
  progress    Progress[]

  @@map("concepts")
}

model Mnemonic {
  id          String   @id @default(cuid())
  conceptId   String
  title       String
  mnemonic    String
  explanation String
  example     String?
  category    String?
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  createdBy   String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  concept     Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@map("mnemonics")
}

model ConceptFavorite {
  id        String   @id @default(cuid())
  userId    String
  conceptId String
  createdAt DateTime @default(now())

  @@unique([userId, conceptId])
  @@map("concept_favorites")
}

model ExamSimulation {
  id             String           @id @default(cuid())
  title          String
  description    String
  field          UserField
  duration       Int
  totalQuestions Int
  passingScore   Int              @default(70)
  difficulty     Difficulty       @default(INTERMEDIATE)
  category       String?
  isActive       Boolean          @default(true)
  isPublic       Boolean          @default(true)
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignments    ExamAssignment[]
  attempts       ExamAttempt[]
  questions      ExamQuestion[]

  @@map("exam_simulations")
}

model ExamQuestion {
  id            String         @id @default(cuid())
  examId        String
  question      String
  options       String
  correctAnswer Int
  explanation   String?
  category      String
  difficulty    Difficulty     @default(INTERMEDIATE)
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  exam          ExamSimulation @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_questions")
}

model ExamAttempt {
  id                 String         @id @default(cuid())
  userId             String
  examId             String
  answers            String
  score              Int
  totalQuestions     Int
  correctAnswers     Int
  timeUsed           Int
  completed          Boolean        @default(false)
  xpEarned           Int            @default(0)
  achievementsEarned String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  exam               ExamSimulation @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_attempts")
}

model ExamAssignment {
  id         String         @id @default(cuid())
  examId     String
  userId     String
  assignedBy String
  dueDate    DateTime?
  notified   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  exam       ExamSimulation @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@map("exam_assignments")
}

model Achievement {
  id               String              @id @default(cuid())
  name             String              @unique
  title            String
  description      String
  icon             String
  category         AchievementCategory
  xpReward         Int                 @default(0)
  condition        String
  tier             AchievementTier     @default(BRONZE)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  progress      Int         @default(100)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model XPTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  source      XPSource
  sourceId    String?
  description String?
  createdAt   DateTime @default(now())

  @@map("xp_transactions")
}

model EmailSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_subscriptions")
}

